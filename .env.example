# Environment Configuration Template
PROJECT_NAME="School Management ERP"
ENVIRONMENT=development
DEBUG=True
API_V1_STR="/api/v1"

# Security
SECRET_KEY="change_this_to_a_very_secret_random_key_in_production_32bytes_min"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=school_erp_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/school_erp_db

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Object Storage (S3 / MinIO)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=school-erp-documents
S3_REGION=us-east-1

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
